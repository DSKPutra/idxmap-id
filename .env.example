# Supabase project (public — safe for the frontend bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mayar.id checkout link shown on the pricing page (public)
VITE_MAYAR_CHECKOUT_URL=https://mayar.id/checkout/your-product

# Early-bird pricing countdown target (ISO 8601, public)
VITE_EARLY_BIRD_DEADLINE=2026-12-31T23:59:59+07:00

# GitBook documentation site URL, linked from the footer
VITE_DOCS_URL=https://docs.idxmap.id

# --- Server-side only: set these as Supabase Edge Function secrets, ---
# --- NEVER in the frontend .env or in VITE_-prefixed variables.      ---
# GEMINI_API_KEY=your-gemini-api-key
# MAYAR_WEBHOOK_SECRET=your-mayar-webhook-secret
